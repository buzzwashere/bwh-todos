# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values (see SETUP.md).
# .env.local is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Frontend (Vite, exposed to the browser — these are public by design) ---
# From your Auth0 SPA application settings.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
# The "Identifier" of the Auth0 API you create (e.g. https://bwh-todos-api).
VITE_AUTH0_AUDIENCE=https://bwh-todos-api

# --- Backend (/api serverless functions — server-only secrets) -------------
# Neon connection string (Dashboard -> Connection Details -> pooled URL).
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Same Auth0 tenant domain as above (no protocol, no trailing slash).
AUTH0_DOMAIN=your-tenant.us.auth0.com
# Must exactly match VITE_AUTH0_AUDIENCE / the Auth0 API Identifier.
AUTH0_AUDIENCE=https://bwh-todos-api
